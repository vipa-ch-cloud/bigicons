<?xml version="1.0" encoding="utf-8"?>
<!-- 1x2 ячеек: minWidth/minHeight = 70n-30 dp (формула AOSP), targetCell* = n.
     minResize равен размеру: лаунчер не должен считать виджет меньше заявленного.
     maxResize = 4 ячейки: не ограничивает рост и не режет заявленный размер.
     Превью с реальным соотношением сторон: previewImage (старые лаунчеры) и previewLayout (API 31+). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="250dp"
    android:targetCellWidth="1"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_icon"
    android:previewImage="@drawable/widget_preview_1x2"
    android:previewLayout="@layout/widget_preview_1x2"
    android:configure="dev.bigicons.app.ConfigActivity"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:description="@string/widget_desc" />
